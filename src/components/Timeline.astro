---
// An editing-suite timeline: tracks of clips over 2018–2026 with a draggable playhead.
// Layout is pure CSS percentages (works without JS); the script adds scrubbing, zoom and playback.
import type { Clip, Track } from "../data/site";
import { fmtRange, fmtMonth } from "../data/site";

interface Props {
  clips: Clip[];
  writing?: { title: string; date: string; href: string }[];
  autoplay?: boolean;
  label?: string;
}
const { clips, writing = [], autoplay = false, label = "Career timeline" } = Astro.props;

const RANGE_START = "2018-06";
const RANGE_END = "2027-01"; // exclusive
const NOW = "2026-11";
const idx = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  return y * 12 + (m - 1);
};
const total = idx(RANGE_END) - idx(RANGE_START);
const pct = (n: number) => `${((n / total) * 100).toFixed(4)}%`;
const startPos = (ym: string) => idx(ym) - idx(RANGE_START);
const endPos = (ym: string | null) => idx(ym ?? NOW) - idx(RANGE_START) + 1;

const TRACKS: { id: Track; name: string; code: string }[] = [
  { id: "project", name: "Projects", code: "V3" },
  { id: "work", name: "Work", code: "V2" },
  { id: "study", name: "Study", code: "V1" },
  { id: "writing", name: "Writing", code: "A1" },
];

// Greedy lanes so overlapping clips on one track stack instead of colliding.
const lanesFor = (list: Clip[]) => {
  const lanes: number[] = [];
  return [...list]
    .sort((a, b) => idx(a.start) - idx(b.start))
    .map((c) => {
      const s = startPos(c.start);
      let lane = lanes.findIndex((end) => end <= s);
      if (lane === -1) { lane = lanes.length; lanes.push(0); }
      lanes[lane] = endPos(c.end);
      return { ...c, lane };
    });
};
const rows = TRACKS.filter((t) => t.id !== "writing" || writing.length).map((t) => {
  const placed = lanesFor(clips.filter((c) => c.track === t.id));
  return { ...t, placed, laneCount: Math.max(1, ...placed.map((p) => p.lane + 1)) };
});

const years: number[] = [];
for (let y = 2019; y <= 2026; y++) years.push(y);

const dayPos = (d: string) => {
  const [y, m, day] = d.split("-").map(Number);
  return idx(`${y}-${String(m).padStart(2, "0")}`) - idx(RANGE_START) + (day - 1) / 31;
};
const clipData = clips.map((c) => ({ id: c.id, track: c.track, title: c.title, sub: c.sub, s: startPos(c.start), e: endPos(c.end), range: fmtRange(c.start, c.end), blurb: c.blurb, href: c.href ?? "" }));
---
<div class="tl" data-timeline data-autoplay={autoplay ? "1" : "0"} data-total={total} data-start={idx(RANGE_START)} data-now={endPos(null) - 0.5}>
  <div class="tl-controls">
    <button class="tl-play" type="button" data-play aria-label="Play the timeline">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path class="i-play" d="M4 2.5v11l9-5.5z" fill="currentColor" /><path class="i-pause" d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor" /></svg>
    </button>
    <output class="tc tl-tc" data-tc aria-live="off">{fmtMonth(NOW)}</output>
    <span class="tl-label">{label}</span>
    <div class="tl-zoom" role="group" aria-label="Zoom">
      <button type="button" data-zoom="1" aria-pressed="true">Fit</button>
      <button type="button" data-zoom="4.6" aria-pressed="false">2025–26</button>
    </div>
  </div>

  <div class="tl-body">
    <div class="tl-heads" aria-hidden="true">
      <div class="tl-ruler-head"></div>
      {rows.map((r) => (
        <div class={`tl-head t-${r.id}`} style={`--lanes:${r.laneCount}`}>
          <span class="tc">{r.code}</span><span class="hn">{r.name}</span>
        </div>
      ))}
    </div>

    <div class="tl-scroll" data-scroll>
      <div class="tl-inner" data-inner>
        <div class="tl-ruler" data-ruler style={`--months:${total}`}>
          {years.map((y) => (
            <span class="tl-year tc" style={`left:${pct(startPos(`${y}-01`))}`}>{y}</span>
          ))}
        </div>

        {rows.map((r) => (
          <div class={`tl-track t-${r.id}`} style={`--lanes:${r.laneCount}`}>
            {r.placed.map((c) => (
              <a
                class="tl-clip"
                href={c.href || undefined}
                data-clip={c.id}
                style={`left:${pct(startPos(c.start))};width:${pct(endPos(c.end) - startPos(c.start))};--lane:${c.lane}`}
                aria-label={`${c.title}, ${c.sub}, ${fmtRange(c.start, c.end)}`}
              >
                <span class="tl-clip-name">{c.title}</span>
              </a>
            ))}
            {r.id === "writing" && writing.map((w) => (
              <a class="tl-tick" href={w.href} style={`left:${pct(dayPos(w.date))}`} aria-label={`Article: ${w.title}`} title={w.title}></a>
            ))}
          </div>
        ))}

        <div class="tl-playhead" data-playhead role="slider" tabindex="0"
          aria-label="Playhead" aria-valuemin="0" aria-valuemax={total} aria-valuenow={endPos(null) - 0.5}
          aria-valuetext={fmtMonth(NOW)} style={`left:${pct(endPos(null) - 0.5)}`}>
          <span class="tl-ph-cap" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="tl-inspector" aria-live="polite">
    <p class="tl-insp-when"><span class="tc" data-insp-when>{fmtMonth(NOW)}</span> on the timeline</p>
    <ul class="tl-insp-list" data-insp-list></ul>
  </div>
  <script type="application/json" data-clips set:html={JSON.stringify(clipData)} />
  <noscript><style>.tl-inspector{display:none}</style></noscript>
</div>

<script>
  import { initTimelines } from "../scripts/timeline";
  initTimelines();
</script>

<style>
  .tl { --head-w: 112px; --lane-h: 30px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-m); overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 300px); grid-template-areas: "controls controls" "body insp"; }
  @media (max-width: 900px) { .tl { grid-template-columns: 1fr; grid-template-areas: "controls" "body" "insp"; } }

  .tl-controls { grid-area: controls; display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--panel-2); }
  .tl-play { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); color: var(--text); cursor: pointer; }
  .tl-play:hover { border-color: var(--playhead); color: var(--playhead); }
  .tl-play .i-pause { display: none; }
  .tl.playing .tl-play .i-pause { display: block; }
  .tl.playing .tl-play .i-play { display: none; }
  .tl-tc { color: #ff8566; font-size: 0.95rem; min-width: 8ch; }
  .tl-label { color: var(--muted); font-size: var(--step--1); }
  .tl-zoom { margin-left: auto; display: flex; border: 1px solid var(--line); border-radius: var(--r-s); overflow: hidden; }
  .tl-zoom button { font: inherit; font-size: var(--step--1); padding: 4px 10px; background: transparent; color: var(--muted); border: 0; cursor: pointer; }
  .tl-zoom button + button { border-left: 1px solid var(--line); }
  .tl-zoom button[aria-pressed="true"] { background: var(--bg); color: var(--text); }
  @media (max-width: 520px) { .tl-label { display: none; } }

  .tl-body { grid-area: body; display: grid; grid-template-columns: var(--head-w) minmax(0, 1fr); min-width: 0; }
  .tl-heads { border-right: 1px solid var(--line); background: var(--panel-2); }
  .tl-ruler-head { height: 28px; border-bottom: 1px solid var(--line); }
  .tl-head { height: calc(var(--lanes) * var(--lane-h) + 12px); display: flex; align-items: center; gap: 8px; padding: 0 12px; font-size: var(--step--1); color: var(--muted); border-bottom: 1px solid var(--line); border-left: 3px solid var(--c); }
  .tl-head .tc { color: var(--muted); }
  @media (max-width: 600px) { .tl { --head-w: 44px; } .tl-head { padding: 0 8px; } .tl-head .hn { display: none; } }
  .t-work { --c: var(--clip-work); }
  .t-study { --c: var(--clip-study); }
  .t-project { --c: var(--clip-project); }
  .t-writing { --c: var(--clip-writing); }

  .tl-scroll { overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .tl-inner { position: relative; width: calc(100% * var(--zoom, 1)); min-width: 720px; transition: width 0.5s var(--ease); touch-action: pan-y; }
  .tl-ruler { position: relative; height: 28px; border-bottom: 1px solid var(--line); cursor: ew-resize;
    background-image: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px calc(100% / var(--months)));
    background-size: 100% 6px; background-repeat: no-repeat; background-position: bottom; }
  .tl-year { position: absolute; top: 5px; transform: translateX(4px); color: var(--muted); font-size: 0.72rem; border-left: 1px solid var(--faint); padding-left: 4px; height: 22px; }

  .tl-track { position: relative; height: calc(var(--lanes) * var(--lane-h) + 12px); border-bottom: 1px solid var(--line); background-image: linear-gradient(90deg, rgba(255,255,255,.015), transparent); }
  .tl-clip { position: absolute; top: calc(6px + var(--lane) * var(--lane-h)); height: calc(var(--lane-h) - 4px); min-width: 6px;
    background: color-mix(in srgb, var(--c) 78%, #000); border: 1px solid color-mix(in srgb, var(--c) 60%, #fff); border-radius: 3px;
    color: #0f1114; text-decoration: none; overflow: hidden; display: flex; align-items: center; padding: 0 6px; cursor: pointer;
    transition: filter 0.15s, box-shadow 0.15s; }
  .tl-clip::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 7px, rgba(0,0,0,.07) 7px 8px); pointer-events: none; }
  .tl-clip:hover, .tl-clip.on { filter: brightness(1.12); box-shadow: 0 0 0 2px var(--text); z-index: 2; }
  .tl-clip.live { box-shadow: inset 0 0 0 1px rgba(255,255,255,.55); }
  .tl-clip-name { position: relative; font-size: 0.76rem; font-weight: 650; font-stretch: 92%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tl-tick { position: absolute; top: 9px; bottom: 9px; width: 3px; border-radius: 2px; background: var(--clip-writing); transform: translateX(-1px); }
  .tl-tick:hover { box-shadow: 0 0 0 2px var(--text); }

  .tl-playhead { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--playhead); z-index: 5; cursor: ew-resize; touch-action: none; }
  .tl-playhead::after { content: ""; position: absolute; inset: 0 -9px; }
  .tl-ph-cap { position: absolute; top: 0; left: 50%; width: 14px; height: 18px; transform: translateX(-50%); background: var(--playhead); clip-path: polygon(0 0, 100% 0, 100% 60%, 50% 100%, 0 60%); }
  .tl-playhead:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--playhead) 45%, transparent); }

  .tl-inspector { grid-area: insp; border-left: 1px solid var(--line); padding: 14px 16px; min-height: 100%; background: var(--panel); }
  @media (max-width: 900px) { .tl-inspector { border-left: 0; border-top: 1px solid var(--line); } }
  .tl-insp-when { color: var(--muted); font-size: var(--step--1); margin-bottom: 10px; }
  .tl-insp-when .tc { color: var(--text); font-size: 1rem; }
  .tl-insp-list { list-style: none; display: grid; gap: 8px; }
  .tl-insp-list :global(li) { border-left: 3px solid var(--c); padding: 4px 0 4px 10px; }
  .tl-insp-list :global(a) { text-decoration: none; display: block; }
  .tl-insp-list :global(a:hover .ttl) { color: var(--playhead); }
  .tl-insp-list :global(.ttl) { font-weight: 680; font-stretch: 110%; display: block; line-height: 1.25; }
  .tl-insp-list :global(.meta) { font-size: var(--step--1); color: var(--muted); display: block; }
  .tl-insp-list :global(.blurb) { font-size: var(--step--1); color: var(--text); opacity: 0.85; display: block; margin-top: 3px; }
  .tl-insp-list :global(.empty) { border: 0; padding: 0; color: var(--faint); font-size: var(--step--1); }
</style>
