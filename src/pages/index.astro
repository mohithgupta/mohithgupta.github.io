---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import ProjectTile from "../components/ProjectTile.astro";
import portrait from "../assets/portrait.png";
import { profile, roles, topWriting, mediumViews, fmtRange, duration } from "../data/site";
import { projects, featured, bySlug } from "../data/projects";
import { clips } from "../data/clips";

const [lead, ...rest] = featured.map(bySlug);
const services = [
  { title: "Frontends from your designs", body: "Figma to production React and TypeScript, pixel-accurate, accessible and fast. I've built this into an agent pipeline that hits 98–99% visual accuracy." },
  { title: "Design systems", body: "Tokens, a component library and the rules, tests and CI checks that keep every screen on-system." },
  { title: "AI features that hold up", body: "LLM features with verification, evals, usage limits and kill switches, so they stay accurate and affordable in production." },
  { title: "Full products, end to end", body: "From the data model to the deploy: auth, background jobs, webhooks, testing and monitoring, built and shipped by one person." },
];
const highlights = [
  { role: roles[0], points: ["Revamped the product UI and built its design system in 45 days", "Re-architected the API layer: Sentry coverage 40% → 95%", "Zero P0 and zero P1 incidents with no dedicated QA"] },
  { role: roles[1], points: ["Founding engineer on the first near real-time anomaly detection platform", "Contributed to two CEO Award-winning platforms, a $50M revenue opportunity", "Co-led UI and QA teams of 9+, with 50% faster app performance"] },
];
---
<Base>
  <section class="suite wrap" aria-labelledby="hero-name">
    <div class="monitors">
      <figure class="source">
        <div class="mon-bar" aria-hidden="true"><span>Source</span><span class="tc">me.jpg</span></div>
        <Image src={portrait} alt="Portrait of Mohith, smiling, in a navy and yellow hoodie" widths={[320, 520, 760]} sizes="(max-width: 900px) 40vw, 340px" loading="eager" fetchpriority="high" class="portrait" />
      </figure>
      <div class="program">
        <div class="mon-bar" aria-hidden="true"><span>Program</span><span class="rec"><i></i>{profile.available}</span></div>
        <div class="program-body">
          <h1 id="hero-name" class="name" data-name>Mohith<br />Korangi</h1>
          <p class="role">Software engineer for frontend and agentic AI. Full stack at Trupeer.ai, four years at Mastercard before that.</p>
          <p class="statement">{profile.statement}</p>
          <div class="ctas">
            <a class="btn btn-primary" href="/hire">Start a project</a>
            <a class="btn btn-ghost" href="/work">See my work</a>
          </div>
        </div>
      </div>
    </div>
    <Timeline clips={clips} autoplay label="Career timeline, drag to scrub" />
  </section>

  <section class="section wrap" aria-labelledby="work-h">
    <div class="section-head">
      <h2 id="work-h">Selected work</h2>
      <p>Products I designed, built and shipped myself, each written up with its architecture, the decisions behind it and what I measured.</p>
    </div>
    <ProjectTile p={lead} size="lead" eager />
    <div class="grid3">
      {rest.map((p) => <ProjectTile p={p} />)}
    </div>
    <p class="more"><a href="/work">All {projects.length} projects, including my agent harness</a></p>
  </section>

  <section class="section band" aria-labelledby="hire-h">
    <div class="wrap hire-grid">
      <div class="section-head">
        <h2 id="hire-h">What I can build for you</h2>
        <p>I take on a small number of freelance projects: new products, frontend rebuilds and AI features for founders and teams who care how it feels to use.</p>
        <div><a class="btn btn-primary" href="/hire">How working with me works</a></div>
      </div>
      <ul class="services">
        {services.map((s) => (
          <li><h3>{s.title}</h3><p>{s.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="exp-h">
    <div class="section-head">
      <h2 id="exp-h">Experience</h2>
      <p>Four and a half years, two very different companies, one habit: owning the outcome, not just the ticket.</p>
    </div>
    <div class="roles">
      {highlights.map(({ role, points }) => (
        <a class="role-card" href={`/experience#${role.id}`}>
          <p class="tc when">{fmtRange(role.start, role.end)}, {duration(role.start, role.end)}</p>
          <h3>{role.company}</h3>
          <p class="muted">{role.titles.map((t) => t.title).join(", then ").split(", then ").reverse().join(", then ")}</p>
          <ul>{points.map((pt) => <li>{pt}</li>)}</ul>
          <span class="go">Read the details</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" id="writing" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">Writing</h2>
      <p>Short, practical JavaScript and React explainers on Medium, read {mediumViews} times. These are the most read.</p>
    </div>
    <ol class="posts">
      {topWriting.map((w) => (
        <li><a href={w.href}><span class="pt">{w.title}</span><span class="go" aria-hidden="true">Read on Medium</span></a></li>
      ))}
    </ol>
    <p class="all-posts"><a href={profile.links.medium}>All articles on Medium</a></p>
  </section>
</Base>

<script>
  // The name widens as the playhead runs through the years: condensed at the start of the career, expanded by now.
  const name = document.querySelector<HTMLElement>("[data-name]");
  if (name && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.addEventListener("timeline:pos", (e) => {
      const p = Math.min(1, Math.max(0, (e as CustomEvent).detail.progress));
      name.style.fontStretch = `${(70 + p * 55).toFixed(1)}%`;
    });
  }
</script>

<style>
  .suite { padding-block: clamp(16px, 2.4vw, 28px) clamp(40px, 6vw, 72px); display: grid; gap: 14px; }
  .monitors { display: grid; grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.6fr); gap: 14px; }
  @media (max-width: 760px) { .monitors { grid-template-columns: 1fr; } .source { display: none; } }
  .source, .program { margin: 0; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-m); overflow: hidden; display: flex; flex-direction: column; }
  .mon-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; height: 30px; padding: 0 12px; border-bottom: 1px solid var(--line); background: var(--panel-2); font-size: 0.75rem; color: var(--muted); }
  .rec { display: inline-flex; align-items: center; gap: 7px; color: var(--text); }
  .rec i { width: 8px; height: 8px; border-radius: 50%; background: var(--playhead); animation: blink 1.6s steps(2, start) infinite; }
  @keyframes blink { to { opacity: 0.25; } }
  .portrait { width: 100%; flex: 1; object-fit: cover; object-position: 50% 22%; min-height: 0; }
  .program-body { padding: clamp(20px, 3vw, 36px) clamp(20px, 4vw, 44px); display: grid; gap: 14px; align-content: center; flex: 1; }
  .name { font-size: clamp(2.9rem, 1.2rem + 5.6vw, 6rem); line-height: 0.88; font-weight: 820; font-stretch: 125%; letter-spacing: -0.025em; text-transform: none; }
  .role { font-size: var(--step-0); color: var(--muted); max-width: 60ch; }
  .statement { font-size: var(--step-1); max-width: 54ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(8px, 2vw, 20px); margin-top: clamp(16px, 3vw, 32px); }
  @media (max-width: 1000px) { .grid3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid3 { grid-template-columns: 1fr; } }
  .more { margin-top: 28px; padding-left: 14px; }

  .band { background: var(--panel); border-block: 1px solid var(--line); }
  .hire-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .hire-grid { grid-template-columns: 1fr; } }
  .hire-grid .section-head { margin-bottom: 0; }
  .hire-grid .section-head div { margin-top: 12px; }
  .services { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); }
  @media (max-width: 560px) { .services { grid-template-columns: 1fr; } }
  .services li { padding: 22px 20px 22px 0; border-bottom: 1px solid var(--line); }
  .services li:nth-child(odd) { padding-right: 24px; }
  @media (min-width: 561px) { .services li:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--line); } }
  .services h3 { font-size: var(--step-1); margin-bottom: 8px; }
  .services p { color: var(--muted); }

  .roles { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 760px) { .roles { grid-template-columns: 1fr; } }
  .role-card { display: grid; gap: 8px; align-content: start; padding: clamp(18px, 3vw, 30px); border: 1px solid var(--line); border-left: 4px solid var(--clip-work); border-radius: var(--r-m); background: var(--panel); text-decoration: none; transition: border-color 0.2s; }
  .role-card:hover { border-color: var(--muted); border-left-color: var(--clip-work); }
  .role-card h3 { font-size: var(--step-2); }
  .when { color: var(--clip-work); }
  .role-card ul { margin: 10px 0 6px; padding-left: 18px; display: grid; gap: 6px; }
  .go { color: var(--muted); font-size: var(--step--1); text-decoration: underline; text-underline-offset: 3px; }
  .role-card:hover .go { color: var(--text); text-decoration-color: var(--playhead); }

  .posts { list-style: none; border-top: 1px solid var(--line); }
  .posts a { display: grid; grid-template-columns: 1fr auto; gap: 16px; padding: 14px 4px; border-bottom: 1px solid var(--line); text-decoration: none; align-items: baseline; }
  .posts a:hover .pt { color: #fff; text-decoration: underline; text-decoration-color: var(--clip-writing); }
  .posts .pt { font-size: var(--step-1); font-weight: 620; font-stretch: 104%; }
  .posts .go { color: var(--clip-writing); font-size: var(--step--1); white-space: nowrap; }
  .all-posts { margin-top: 18px; color: var(--muted); }
  @media (max-width: 560px) { .posts a { grid-template-columns: 1fr; gap: 4px; } }
</style>
