---
import Base from "../layouts/Base.astro";
import Reel from "../components/Reel.astro";
import ProjectTile from "../components/ProjectTile.astro";
import { profile, topWriting, mediumViews } from "../data/site";
import { projects, featured, bySlug } from "../data/projects";

// Bento order: the lead fills two columns and two rows, then four tiles and a link to the rest.
const [lead, ...rest] = [...featured, "agentic-harness"].map(bySlug);
const others = projects.filter((p) => ![lead, ...rest].includes(p));
const services = [
  { title: "Frontends from your designs", body: "Figma to production React and TypeScript, pixel-accurate, accessible and fast. I've built this into an agent pipeline that hits 98–99% visual accuracy." },
  { title: "Design systems", body: "Tokens, a component library and the rules, tests and CI checks that keep every screen on-system." },
  { title: "AI features that hold up", body: "LLM features with verification, evals, usage limits and kill switches, so they stay accurate and affordable in production." },
  { title: "Full products, end to end", body: "From the data model to the deploy: auth, background jobs, webhooks, testing and monitoring, built and shipped by one person." },
];
---
<Base>
  <Reel />

  <section class="section wrap" id="work" aria-labelledby="work-h">
    <div class="section-head">
      <h2 id="work-h">Selected work</h2>
      <p>Products I designed, built and shipped myself, each written up with its architecture, the decisions behind it and what I measured.</p>
    </div>
    <div class="bento">
      <div class="b-lead"><ProjectTile p={lead} size="lead" eager /></div>
      {rest.map((p) => <ProjectTile p={p} />)}
      <a class="b-more" href="/work">
        <span class="b-count">{projects.length}</span>
        <span class="b-t">See every project</span>
        <span class="b-s">Including {others.map((p) => p.title).join(", ")}, each with its architecture and measured results.</span>
      </a>
    </div>
  </section>

  <section class="section band" aria-labelledby="hire-h">
    <div class="wrap hire-grid">
      <div class="section-head">
        <h2 id="hire-h">What I build</h2>
        <p>New products, frontend rebuilds and AI features, for teams who care how their product feels to use.</p>
        <div><a class="btn btn-ghost" href="/hire">Work with me</a></div>
      </div>
      <ul class="services">
        {services.map((s) => (
          <li><h3>{s.title}</h3><p>{s.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section wrap" id="writing" aria-labelledby="writing-h">
    <div class="section-head">
      <h2 id="writing-h">Writing</h2>
      <p>Short, practical explainers on JavaScript, React and developer tools, viewed {mediumViews} times on Medium. These five are the most viewed.</p>
    </div>
    <ol class="posts">
      {topWriting.map((w) => (
        <li><a href={w.href}><span class="pt">{w.title}</span><span class="views tc">{w.views} views</span></a></li>
      ))}
    </ol>
    <p class="all-posts"><a href={profile.links.medium}>All articles on Medium</a></p>
  </section>
</Base>

<style>
  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .b-lead { grid-column: span 2; grid-row: span 2; display: grid; }
  .bento > :global(*) { min-width: 0; }
  .b-more { display: grid; align-content: end; gap: 8px; padding: 24px; border-radius: 14px; border: 1px dashed var(--line); text-decoration: none; background: repeating-linear-gradient(90deg, transparent 0 33px, color-mix(in srgb, var(--line) 50%, transparent) 33px 34px); transition: border-color 0.25s; }
  .b-more:hover { border-color: var(--playhead); }
  .b-count { font-size: var(--step-4); font-weight: 820; font-stretch: 120%; line-height: 1; color: var(--clip-project); }
  .b-t { font-size: var(--step-2); font-weight: 760; font-stretch: 112%; }
  .b-more:hover .b-t { text-decoration: underline; text-decoration-color: var(--playhead); text-underline-offset: 5px; }
  .b-s { color: var(--muted); }
  @media (max-width: 1000px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } .b-lead { grid-row: auto; } }
  @media (max-width: 640px) { .bento { grid-template-columns: minmax(0, 1fr); } .b-lead { grid-column: auto; } }

  .band { background: var(--panel); border-block: 1px solid var(--line); }
  .hire-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .hire-grid { grid-template-columns: 1fr; } }
  .hire-grid .section-head { margin-bottom: 0; }
  .hire-grid .section-head div { margin-top: 12px; }
  .services { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); }
  @media (max-width: 560px) { .services { grid-template-columns: 1fr; } }
  .services li { padding: 22px 20px 22px 0; border-bottom: 1px solid var(--line); }
  .services li:nth-child(odd) { padding-right: 24px; }
  @media (min-width: 561px) { .services li:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--line); } }
  .services h3 { font-size: var(--step-1); margin-bottom: 8px; }
  .services p { color: var(--muted); }

  .posts { list-style: none; border-top: 1px solid var(--line); }
  .posts a { display: grid; grid-template-columns: 1fr auto; gap: 16px; padding: 14px 4px; border-bottom: 1px solid var(--line); text-decoration: none; align-items: baseline; }
  .posts a:hover .pt { color: #fff; text-decoration: underline; text-decoration-color: var(--clip-writing); }
  .posts .pt { font-size: var(--step-1); font-weight: 620; font-stretch: 104%; }
  .posts .views { color: var(--clip-writing); white-space: nowrap; }
  .all-posts { margin-top: 18px; color: var(--muted); }
  @media (max-width: 560px) { .posts a { grid-template-columns: 1fr; gap: 4px; } }
</style>
